    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:background="#ececec"
        android:orientation="horizontal"
        android:weightSum="3">
        <!--        android:layout_below="@id/appBar"-->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:orientation="vertical">

            <!-- ALL BRANDS HEADER -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clAllBrands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_box"
                android:padding="@dimen/_8sdp">

                <TextView
                    android:id="@+id/tvAllBrands"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="All Brands"
                    android:textStyle="bold"
                    android:textSize="@dimen/_6sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/imgAllBrandArrow"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ImageView
                    android:id="@+id/imgAllBrandArrow"
                    android:layout_width="@dimen/_6sdp"
                    android:layout_height="@dimen/_6sdp"
                    android:src="@drawable/arrow_down"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BRAND LIST (Existing RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/brandNameRecView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:scrollbars="vertical"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/brandMatrix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/selector_box"
                android:padding="@dimen/_8sdp">

                <TextView
                    android:id="@+id/tvBrandMatrix"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Brand Matrix"
                    android:textStyle="bold"
                    android:textSize="@dimen/_6sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/imgBrandMatrixArrow"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ImageView
                    android:id="@+id/imgBrandMatrixArrow"
                    android:layout_width="@dimen/_6sdp"
                    android:layout_height="@dimen/_6sdp"
                    android:src="@drawable/arrow_down"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/brandMatrixRecView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:scrollbars="vertical"/>

            <TextView
                android:id="@+id/tvNoBrandMatrix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Brand Matrix Available"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone"/>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/speciality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/selector_box"
                android:padding="@dimen/_8sdp">

                <TextView
                    android:id="@+id/tvspeciality"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Speciality"
                    android:textStyle="bold"
                    android:textSize="@dimen/_6sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/imgspecialityArrow"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ImageView
                    android:id="@+id/imgspecialityArrow"
                    android:layout_width="@dimen/_6sdp"
                    android:layout_height="@dimen/_6sdp"
                    android:src="@drawable/arrow_down"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/specialityRecView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:scrollbars="vertical"/>

            <TextView
                android:id="@+id/tvNospeciality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Speciality Available"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone"/>

        </LinearLayout>

<!--        <androidx.recyclerview.widget.RecyclerView-->
<!--            android:id="@+id/brandNameRecView"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="match_parent"-->
<!--            android:layout_weight="0.7"-->
<!--            android:scrollbars="vertical" />-->

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_3sdp"
            android:layout_weight="1.4"
            app:cardCornerRadius="@dimen/_3sdp"
            app:cardElevation="0dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/slideImageRecView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_4sdp" />

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_3sdp"
            android:layout_weight="0.9"
            app:cardCornerRadius="@dimen/_3sdp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:fontFamily="@font/satoshi_medium"
                        android:gravity="start"
                        android:padding="@dimen/_6sdp"
                        android:text="Slides"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/_7sdp"
                        tools:ignore="SpUsage" />

                    <TextView
                        android:id="@+id/selectedSlideCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:background="@drawable/edittext_stroke"
                        android:backgroundTint="#26282A3C"
                        android:fontFamily="@font/satoshi_medium"
                        android:gravity="end"
                        android:paddingStart="@dimen/_5sdp"
                        android:paddingTop="@dimen/_3sdp"
                        android:paddingEnd="@dimen/_5sdp"
                        android:paddingBottom="@dimen/_3sdp"
                        android:text="0"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/_6sdp"
                        tools:ignore="SpUsage" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/slidesRecView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="@dimen/_3sdp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/satoshi_variable"
                        android:gravity="center"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/clear"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_purple"
                        android:textSize="@dimen/_6ssp"
                        app:icon="@drawable/baseline_close_24"
                        app:iconGravity="textStart"
                        app:iconSize="@dimen/_8sdp"
                        style="?attr/materialButtonOutlinedStyle"
                        app:backgroundTint="@null"
                        android:background="@drawable/clear_btn_stroke"/>

                    <View
                        android:layout_width="@dimen/_2sdp"
                        android:layout_height="match_parent" />

                    <Button
                        android:id="@+id/playBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/tp_btn_select_state"
                        android:fontFamily="@font/satoshi_variable"
                        android:gravity="center"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/start"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_6ssp"
                        app:icon="@drawable/play_icon"
                        app:iconGravity="textStart"
                        app:iconSize="@dimen/_7sdp" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</RelativeLayout>