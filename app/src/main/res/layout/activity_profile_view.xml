<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_grey"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/view_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp"
        android:background="@color/dark_purple"
        android:orientation="horizontal" >

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/_16sdp"
        android:layout_height="@dimen/_15sdp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:cropToPadding="true"
        android:layout_gravity="center_vertical"
        android:padding="@dimen/_2sdp"
        android:src="@drawable/arrow_back_white" />

    <TextView
        android:id="@+id/tag_selection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:fontFamily="@font/satoshi_bold"
        android:layout_gravity="center_vertical"
        android:padding="@dimen/_2sdp"
        android:text="Profile"
        android:textColor="@color/white"
        android:textSize="@dimen/_8sdp"
        android:textStyle="bold" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_25sdp"
        android:background="@drawable/border_spinner_uneditable"
        android:backgroundTint="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_45sdp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:src="@drawable/acount_img" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_bold"
                    android:gravity="center"
                    android:textColor="#282A3C"
                    android:textSize="@dimen/_7ssp"
                    android:text="Name"/>

            </LinearLayout>

        </LinearLayout>
        <View
            android:id="@+id/viewProf"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginTop="220dp"
            android:background="@color/light_grey"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/viewProf"
            android:layout_marginTop="@dimen/_2sdp"
            android:orientation="vertical"
            android:weightSum="3">

            <LinearLayout
                android:id="@+id/Linear1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/one_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_dr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:text="@string/division"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/edt_dctr"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginBottom="@dimen/_1sdp"
                        android:layout_marginTop="5dp"
                        android:drawablePadding="@dimen/_5sdp"
                        android:padding="5dp"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        android:background="@drawable/bg_light_grey"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_6ssp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/two_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_hq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/sub_division"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/txt_select_hq"
                        android:layout_width="match_parent"
                        android:layout_marginTop="5dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:padding="5dp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginBottom="@dimen/_1sdp"
                        android:background="@drawable/bg_light_grey"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_6ssp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/three_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_Territory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/hq"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/txt_select_territory"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginBottom="@dimen/_1sdp"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_6ssp"
                        android:layout_marginTop="5dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:background="@drawable/bg_light_grey"
                        android:padding="5dp" />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/Linear2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/one_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/desig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/designation"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/desig_name"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginBottom="@dimen/_1sdp"
                        android:layout_marginTop="5dp"
                        android:drawablePadding="@dimen/_5sdp"
                        android:padding="5dp"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_6ssp"
                        android:background="@drawable/bg_light_grey"
                        />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/two_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/start_dt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/dcr_start_dt"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/start_dt_txt"
                        android:layout_width="match_parent"
                        android:layout_marginTop="5dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:padding="5dp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginBottom="@dimen/_1sdp"
                        android:background="@drawable/bg_light_grey"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_6ssp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/three_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tp_start_dt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/tp_start_dt"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tp_start_dt_txt"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginBottom="@dimen/_1sdp"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_6ssp"
                        android:layout_marginTop="5dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:background="@drawable/bg_light_grey"
                        android:padding="5dp" />
                </LinearLayout>


            </LinearLayout>
            <LinearLayout
                android:id="@+id/Linear3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/one_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dcr_rpt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/dcr_rpt"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/dcr_rpt_name"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginBottom="@dimen/_1sdp"
                        android:layout_marginTop="5dp"
                        android:drawablePadding="@dimen/_5sdp"
                        android:padding="5dp"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_6ssp"
                        android:background="@drawable/bg_light_grey"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/two_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tp_rpt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/tp_rpt"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tp_rpt_name"
                        android:layout_width="match_parent"
                        android:layout_marginTop="5dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:padding="5dp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginBottom="@dimen/_1sdp"
                        android:background="@drawable/bg_light_grey"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_6ssp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/three_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lev_rpt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/lev_rpt"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/lev_rpt_name"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginBottom="@dimen/_1sdp"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_6ssp"
                        android:layout_marginTop="5dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:background="@drawable/bg_light_grey"
                        android:padding="5dp" />
                </LinearLayout>


            </LinearLayout>
            <LinearLayout
                android:id="@+id/Linear4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/one_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tp_mand_range"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/tp_mand_range"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tp_mand_range_txt"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginBottom="@dimen/_1sdp"
                        android:layout_marginTop="5dp"
                        android:drawablePadding="@dimen/_5sdp"
                        android:padding="5dp"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_6ssp"
                        android:background="@drawable/bg_light_grey" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/two_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    >

                    <TextView
                        android:id="@+id/tpp_rpt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/tp_rpt"
                        android:textColor="#000000"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tpp_rpt_name"
                        android:layout_width="match_parent"
                        android:layout_marginTop="5dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:padding="5dp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginBottom="@dimen/_1sdp"
                        android:background="@drawable/border_shape_spinner"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_6ssp"
                        android:visibility="gone"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/three_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/levv_rpt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/lev_rpt"
                        android:textColor="#000000"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/levv_rpt_name"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginBottom="@dimen/_1sdp"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_6ssp"
                        android:layout_marginTop="5dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:padding="5dp"
                        android:visibility="gone"/>
                </LinearLayout>


            </LinearLayout>


        </LinearLayout>





    </RelativeLayout>

</LinearLayout>