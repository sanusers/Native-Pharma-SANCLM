<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraint_main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/tv_head2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="@font/satoshi_bold"
            android:gravity="center"
            android:padding="@dimen/_2sdp"
            android:text="Unlisted JointWork"
            android:textColor="@color/dark_purple"
            android:textSize="@dimen/_6ssp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="NotSibling" />

        <View
            android:id="@+id/view_dummy2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginVertical="@dimen/_2sdp"
            android:background="@color/light_grey_3"
            app:layout_constraintBottom_toTopOf="@id/unlisted_jointwork"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_head2"
            app:layout_constraintVertical_bias="0.0" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/unlisted_jointwork"
            android:layout_width="0dp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_2sdp"
            android:background="@drawable/bg_light_cement"
            android:hint="Type unlisted Name"
            android:padding="@dimen/_4sdp"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="start"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textSize="@dimen/_6ssp"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/second_constraint"
            app:layout_constraintTop_toBottomOf="@id/view_dummy2"
            app:layout_constraintBottom_toTopOf="@id/rl_btns"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/second_constraint"
            android:layout_width="0dp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:background="@drawable/bg_light_cement"
            android:gravity="start"
            android:inputType="text"
            android:maxLines="1"
            android:padding="@dimen/_4sdp"
            android:singleLine="true"
            android:hint="Select Speciality"
            android:imeOptions="actionDone"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="@dimen/_8sdp"
            android:textSize="@dimen/_6ssp"
            android:fontFamily="@font/satoshi_medium"
            app:drawableEndCompat="@drawable/spin_down_arrow"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/unlisted_jointwork"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/unlisted_jointwork"
            app:layout_constraintBottom_toBottomOf="@id/unlisted_jointwork" />
