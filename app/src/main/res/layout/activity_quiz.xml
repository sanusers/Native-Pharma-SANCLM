<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/text_dark"
            android:backgroundTint="@color/text_dark"
            android:minHeight="?attr/actionBarSize"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="0dp">

            <LinearLayout
                android:id="@+id/backArrow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:padding="@dimen/_6sdp">

                <ImageView
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:src="@drawable/arrow_back_white"
                    tools:ignore="ContentDescription" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:fontFamily="@font/satoshi_variable"
                android:text="Quiz"
                android:textColor="@color/white"
                android:textSize="@dimen/_7sdp" />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:id="@+id/rl_quiz_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appBar"
        android:background="@color/backround_graey"
        android:visibility="gone">


        <LinearLayout
            android:id="@+id/ll_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/rl_btns"
            android:layout_margin="@dimen/_5sdp"
            android:background="@drawable/custom_backround_layout"
            android:backgroundTint="@color/white"
            android:orientation="horizontal">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/txt_queston_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:fontFamily="@font/satoshi_medium"
                    android:padding="@dimen/_2sdp"
                    android:textColor="@color/black_45"
                    android:textSize="@dimen/_8sdp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txt_queston_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txt_queston_no"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:fontFamily="@font/satoshi_medium"
                    android:padding="@dimen/_2sdp"

                    android:textColor="@color/black_45"
                    android:textSize="@dimen/_8sdp"
                    android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_above="@id/view_dummy"
                    android:layout_below="@id/txt_queston_name"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="visible">

                        <RadioGroup
                            android:id="@+id/radio_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:gravity="left">


                            <RadioButton
                                android:id="@+id/radio_button1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/satoshi_medium"
                                android:gravity="left|center"
                                android:text="Option 1"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_8sdp" />

                            <RadioButton
                                android:id="@+id/radio_button2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/satoshi_medium"
                                android:gravity="left|center"
                                android:text="Option 3"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_8sdp" />

                            <RadioButton
                                android:id="@+id/radio_button3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/satoshi_medium"
                                android:gravity="left|center"
                                android:text="Option 3"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_8sdp" />

                            <RadioButton
                                android:id="@+id/radio_button4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/satoshi_medium"
                                android:gravity="left|center"
                                android:text="Option 4"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_8sdp" />

                            <RadioButton
                                android:id="@+id/radio_button5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/satoshi_medium"
                                android:gravity="left|center"
                                android:text="Option 5"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_8sdp" />


                            <RadioButton
                                android:id="@+id/radio_button6"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/satoshi_medium"
                                android:gravity="left|center"
                                android:text="Option 6"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_8sdp" />

                            <RadioButton
                                android:id="@+id/radio_button7"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/satoshi_medium"
                                android:gravity="left|center"
                                android:text="Option 7"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_8sdp" />

                            <RadioButton
                                android:id="@+id/radio_button8"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/satoshi_medium"
                                android:gravity="left|center"
                                android:text="Option 8"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_8sdp" />

                        </RadioGroup>
                    </LinearLayout>
                </ScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyelerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txt_queston_name"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:visibility="visible">

                </androidx.recyclerview.widget.RecyclerView>

                <View
                    android:id="@+id/view_dummy"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_above="@id/rl_btns1"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="#9e9ea5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

                <RelativeLayout
                    android:id="@+id/rl_btns1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:layout_marginEnd="@dimen/_3sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnpreview"
                        android:layout_width="@dimen/_50sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_toLeftOf="@id/btn_next"
                        android:background="@drawable/bg_border_with_pink"
                        android:fontFamily="@font/satoshi_bold"
                        android:text="@string/preview"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_purple"
                        android:textSize="@dimen/_7sdp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_next"
                        android:layout_width="@dimen/_50sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_alignParentEnd="true"
                        android:layout_toEndOf="@id/btn_skip"
                        android:background="@drawable/bg_border_with_pink"
                        android:fontFamily="@font/satoshi_bold"
                        android:singleLine="true"
                        android:text="Next"
                        android:textAllCaps="false"
                        android:textColor="@color/black_45"
                        android:textSize="@dimen/_7sdp"
                        android:textStyle="bold"
                        tools:ignore="NotSibling" />
                </RelativeLayout>

            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_3sdp">

                    <ImageView
                        android:layout_width="@dimen/_9sdp"
                        android:layout_height="@dimen/_9sdp"
                        android:layout_gravity="start|center_vertical"
                        android:src="@drawable/clock">

                    </ImageView>

                    <TextView
                        android:id="@+id/txt_remainigtime_cap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_2sdp"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_2sdp"
                        android:text="RemainingTime: "
                        android:textColor="@color/black_45"
                        android:textSize="@dimen/_8sdp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_remainigtime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_2sdp"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_2sdp"
                        android:text="24:05:24"
                        android:textColor="@color/black_45"
                        android:textSize="@dimen/_8sdp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/custom_backround_layout"
                    android:backgroundTint="#e1f2fd">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/sk_recylerview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5sdp"
                        android:background="#e1f2fd"
                        android:orientation="vertical" />

                </LinearLayout>


            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rl_btns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnskip"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_toLeftOf="@id/btn_save"
                android:background="@drawable/bg_border_with_pink"
                android:fontFamily="@font/satoshi_bold"
                android:text="Close"
                android:textAllCaps="false"
                android:textColor="@color/dark_purple"
                android:textSize="@dimen/_7sdp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/btn_skip"
                android:background="@drawable/backround_button"
                android:fontFamily="@font/satoshi_bold"
                android:singleLine="true"
                android:text="Sumit"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_7sdp"
                android:textStyle="bold"
                tools:ignore="NotSibling" />
        </RelativeLayout>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_start_quiz"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appBar"
        android:visibility="visible"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/ll_quiz_center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/_10sdp">

                <ImageView
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/bulb" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:fontFamily="@font/satoshi_medium"
                    android:padding="@dimen/_2sdp"
                    android:text="@string/welcome_to_quiz_session"
                    android:textColor="@color/black_45"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/download_asserts_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:background="@drawable/bg_green_border"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/satoshi_medium"
                    android:padding="@dimen/_5sdp"
                    android:text="Download Asserts"
                    android:textColor="@color/green_60"
                    android:textSize="@dimen/_6ssp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/outline_cloud_download_24"
                    app:drawableTint="@color/green_60" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:fontFamily="@font/satoshi_medium"
                    android:padding="@dimen/_2sdp"
                    android:text="@string/general_instructions"
                    android:textColor="@color/black_45"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_instructions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/satoshi_medium"
                    android:padding="@dimen/_2sdp"
                    android:text="1.  Download and Read asserts given before starting the session.\n2. Should Attend all questions without fail"
                    android:textColor="@color/text_grey"
                    android:textSize="@dimen/_6ssp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/start_quiz_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:background="@drawable/backround_button"
                    android:fontFamily="@font/satoshi_medium"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:text="@string/start_quiz"
                    android:textColor="@color/white" />

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/bg_grey"
            android:padding="@dimen/_10sdp"
            android:layout_margin="@dimen/_5sdp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/satoshi_medium"
                android:padding="@dimen/_2sdp"
                android:text="@string/no_of_questions"
                android:textColor="@color/black_45"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/satoshi_medium"
                android:padding="@dimen/_2sdp"
                android:text="0"
                android:id="@+id/no_of_questions"
                android:textColor="@color/black_45"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/satoshi_medium"
                android:padding="@dimen/_2sdp"
                android:text="@string/no_of_attempts_allowed"
                android:textColor="@color/black_45"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/satoshi_medium"
                android:padding="@dimen/_2sdp"
                android:text="0"
                android:id="@+id/no_of_attempts_allowed"
                android:textColor="@color/black_45"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:src="@drawable/clock"
                    android:layout_gravity="center"
                    android:id="@+id/clock"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/satoshi_medium"
                android:padding="@dimen/_2sdp"
                android:text="@string/total_time"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/satoshi_medium"
                android:padding="@dimen/_2sdp"
                android:text="00:00:00"
                android:id="@+id/total_time"
                android:textColor="@color/text_grey"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appBar"
        android:id="@+id/rl_score"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            app:lottie_rawRes="@raw/completed"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"
            android:layout_centerInParent="true"
            android:id="@+id/completed_anim"
            android:layout_marginBottom="@dimen/_20sdp"
            android:layout_above="@id/score"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/score"
            android:layout_centerInParent="true"
            android:fontFamily="@font/satoshi_variable"
            android:text="0 out of 0"
            android:textColor="@color/dark_purple"
            android:textSize="@dimen/_7sdp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:id="@+id/thank_you"
            android:layout_below="@id/score"
            android:layout_marginTop="@dimen/_20sdp"
            android:fontFamily="@font/satoshi_variable"
            android:textColor="@color/dark_purple"
            android:textSize="@dimen/_7sdp"
            android:text="Thank you for attending the challenge"/>

    </RelativeLayout>

</RelativeLayout>