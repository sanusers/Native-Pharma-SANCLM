<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.Survey.SurveyActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/text_dark"
                android:backgroundTint="@color/text_dark"
                android:minHeight="?attr/actionBarSize"
                tools:layout_editor_absoluteX="0dp"
                tools:layout_editor_absoluteY="0dp">

                <ImageView
                    android:id="@+id/backArrow"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:padding="@dimen/_6sdp"
                    android:src="@drawable/arrow_back_white"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:fontFamily="@font/satoshi_variable"
                    android:text="@string/survey"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_7ssp" />

            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.AppBarLayout>

        <RelativeLayout
            android:id="@+id/rl_no_survey"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/img_not_found1"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="@dimen/_1sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:src="@drawable/no_data_folder" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/img_not_found1"
                android:layout_centerInParent="true"
                android:layout_marginVertical="@dimen/_2sdp"
                android:fontFamily="@font/satoshi_medium"
                android:padding="@dimen/_2sdp"
                android:text="No Survey Found"
                android:textColor="@color/dark_purple"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />
        </RelativeLayout>


        <LinearLayout
            android:id="@+id/ll_mainLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/backround_graey"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/list_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:fontFamily="@font/satoshi_medium"
                android:padding="@dimen/_2sdp"
                android:text="List of Survey"
                android:textColor="@color/black_45"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_2sdp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_weight="2">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_survey_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <ProgressBar
                        android:id="@+id/progressMain"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        android:backgroundTint="@color/black_45"
                        android:visibility="gone" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/rl_no_data"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:background="@color/white"
                        android:visibility="visible">

                        <ImageView
                            android:id="@+id/img_not_found"
                            android:layout_width="@dimen/_100sdp"
                            android:layout_height="@dimen/_100sdp"
                            android:layout_centerInParent="true"
                            android:layout_marginHorizontal="@dimen/_1sdp"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:src="@drawable/no_data_folder" />

                        <TextView
                            android:id="@+id/tv_content"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/img_not_found"
                            android:layout_centerInParent="true"
                            android:layout_marginVertical="@dimen/_2sdp"
                            android:fontFamily="@font/satoshi_medium"
                            android:padding="@dimen/_2sdp"
                            android:text="Select any survey on list to view content"
                            android:textColor="@color/dark_purple"
                            android:textSize="@dimen/_7ssp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/img_not_found" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlDetailsMain"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/_4sdp"
                        android:background="@drawable/custom_backround_layout"
                        android:backgroundTint="@color/white"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/name_choose_survey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_margin="@dimen/_2sdp"
                            android:fontFamily="@font/satoshi_medium"
                            android:padding="@dimen/_3sdp"
                            android:text="Choose Survey"
                            android:textColor="@color/black_45"
                            android:textSize="@dimen/_7ssp"
                            android:textStyle="bold">

                        </TextView>

                        <ScrollView
                            android:id="@+id/rl_data_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_above="@+id/ll_btns"
                            android:layout_below="@id/name_choose_survey"
                            android:layout_margin="@dimen/_2sdp"
                            android:background="@drawable/custom_backround_layout"
                            android:backgroundTint="@color/backround_graey"
                            android:visibility="visible">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <LinearLayout
                                    android:id="@+id/llSurveyDetailsView"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical">
                                </LinearLayout>

                                <ProgressBar
                                    android:id="@+id/progrlessdetail"
                                    android:layout_width="@dimen/_25sdp"
                                    android:layout_height="@dimen/_25sdp"
                                    android:layout_centerInParent="true"
                                    android:layout_gravity="center"
                                    android:backgroundTint="@color/black_45"
                                    android:visibility="gone" />
                            </RelativeLayout>

                        </ScrollView>

                        <LinearLayout
                            android:id="@+id/ll_btns"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_margin="@dimen/_2sdp"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_clearall"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_20sdp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_border_with_pink"
                                android:fontFamily="@font/satoshi_medium"
                                android:gravity="center"
                                android:padding="@dimen/_4sdp"
                                android:text="@string/clear_all"
                                android:textAllCaps="false"
                                android:textColor="@color/dark_purple"
                                android:textSize="@dimen/_7ssp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="@dimen/_2sdp"
                                android:layout_height="match_parent" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_submit"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_20sdp"
                                android:layout_weight="1"
                                android:background="@drawable/edittext_stroke"
                                android:fontFamily="@font/satoshi_medium"
                                android:gravity="center"
                                android:padding="@dimen/_4sdp"
                                android:text="@string/submit"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_7ssp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/black_45" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progress_submit"
                            android:layout_width="@dimen/_25sdp"
                            android:layout_height="@dimen/_25sdp"
                            android:layout_centerInParent="true"
                            android:backgroundTint="@color/black_45"
                            android:visibility="gone" />

                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/slide_screen"
        layout="@layout/sidescreen_activity" />

</androidx.drawerlayout.widget.DrawerLayout>