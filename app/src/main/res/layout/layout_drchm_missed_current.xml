                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/satoshi_bold"
                        android:text="20"
                        android:textSize="@dimen/_5ssp"
                        android:textColor="@color/black" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>

