<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_130sdp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="6dp">

        <!-- Parent ConstraintLayout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Header -->
            <TextView
                android:id="@+id/headerTxt"
                android:layout_width="0dp"
                android:layout_height="@dimen/_15sdp"
                android:gravity="center"
                android:text="MR Name - HQ - Designation"
                android:textColor="@color/red_60"
                android:fontFamily="@font/satoshi_bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Divider -->
            <View
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/gray_20"
                app:layout_constraintTop_toBottomOf="@id/headerTxt"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Doctor Image -->
            <ImageView
                android:id="@+id/doctorImg"
                android:layout_width="52dp"
                android:layout_height="@dimen/_25sdp"
                android:src="@drawable/doctor_img"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_7sdp"/>

            <!-- Doctor Visit Label -->
            <TextView
                android:id="@+id/doctorVisitTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_bold"
                android:text="Doctor Visit"
                android:textColor="@color/black"
                android:textSize="@dimen/_6sdp"
                app:layout_constraintStart_toEndOf="@id/doctorImg"
                app:layout_constraintTop_toTopOf="@id/doctorImg"
                android:layout_marginStart="@dimen/_5sdp"/>

            <!-- Date -->
            <TextView
                android:id="@+id/dateTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_bold"
                android:text="Oct 2025"
                android:textColor="@color/black"
                android:textSize="@dimen/_6sdp"
                app:layout_constraintStart_toStartOf="@id/doctorImg"
                app:layout_constraintTop_toBottomOf="@id/doctorImg"
                android:layout_marginTop="@dimen/_2sdp"/>

            <!-- Grid Section -->
            <GridLayout
                android:id="@+id/statsGrid"
                android:layout_width="@dimen/_158sdp"
                android:layout_height="@dimen/_54sdp"
                android:background="@drawable/border_spinner_uneditable"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dateTxt"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:rowCount="2"
                android:columnCount="3">

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_52sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:id="@+id/grid1"
                    android:layout_margin="2dp"
                    android:layout_row="0"
                    android:layout_column="0">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:text="Total Visit"
                            android:layout_gravity="center_horizontal"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20"
                            android:textColor="@color/black"
                            android:fontFamily="@font/satoshi_bold"
                            android:layout_gravity="center_horizontal"/>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:id="@+id/grid2"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/backround_lite_gray_border">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:text="Visited"
                            android:layout_gravity="center_horizontal"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20"
                            android:textColor="@color/black"
                            android:fontFamily="@font/satoshi_bold"
                            android:layout_gravity="center_horizontal"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:id="@+id/grid3"
                    android:layout_row="0"
                    android:layout_column="2"
                    android:layout_margin="2dp"

                    android:background="@drawable/backround_lite_gray_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:text="Missed"
                            android:layout_gravity="center_horizontal"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20"
                            android:textColor="@color/black"
                            android:fontFamily="@font/satoshi_bold"
                            android:layout_gravity="center_horizontal"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_52sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:id="@+id/grid4"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_margin="2dp"

                    android:background="@drawable/backround_lite_gray_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:text="Field Work Days" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/satoshi_bold"
                            android:text="20"
                            android:textColor="@color/black" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:id="@+id/grid5"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_margin="2dp"

                    android:background="@drawable/backround_lite_gray_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:text="Call Average" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/satoshi_bold"
                            android:text="20"
                            android:textColor="@color/black" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:id="@+id/grid6"
                    android:layout_row="1"
                    android:layout_column="2"
                    android:layout_margin="2dp"
                    android:background="@drawable/backround_lite_gray_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:text="Coverage" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/satoshi_bold"
                            android:text="20"
                            android:textColor="@color/black" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>


            </GridLayout>

            <!-- Bar Chart Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/barChartCard"
                android:layout_width="410dp"
                android:layout_height="@dimen/_92sdp"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@id/statsGrid"
                app:layout_constraintTop_toBottomOf="@+id/headerTxt"
                android:layout_marginStart="@dimen/_6sdp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <include
                        android:id="@+id/in_chart_visit"
                        layout="@layout/barchartvisit"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pie Chart Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/pieChartCard"
                android:layout_width="320dp"
                android:layout_height="@dimen/_92sdp"
                app:layout_constraintStart_toEndOf="@id/barChartCard"
                app:layout_constraintTop_toTopOf="@id/barChartCard"
                android:layout_marginStart="@dimen/_6sdp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pieChart_visit"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
