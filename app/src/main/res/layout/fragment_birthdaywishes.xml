<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gray_border"
    android:orientation="vertical">

    <!-- No Data Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_no_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/_10sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_not_found"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_100sdp"
            android:layout_marginHorizontal="@dimen/_1sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:src="@drawable/no_data_folder"
            android:windowSoftInputMode="adjustResize|adjustPan"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_2sdp"
            android:fontFamily="@font/satoshi_medium"
            android:padding="@dimen/_2sdp"
            android:text="@string/no_data_found"
            android:textColor="@color/dark_purple"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_not_found"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--    <ListView-->
    <!--        android:id="@+id/listviewBirthday"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="0dp"-->
    <!--        android:layout_weight="1"-->
    <!--        android:visibility="gone"-->
    <!--        android:divider="@android:color/darker_gray"-->
    <!--        android:dividerHeight="1dp"/>-->
    <ScrollView

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Today -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp">

                <TextView
                    android:id="@+id/header_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/Green_45"
                    android:background="@drawable/gray_border"
                    android:backgroundTint="@color/green_10"
                    android:padding="5dp"
                    android:text=" Today "
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingVertical="4dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#BDBDBD" />
            </LinearLayout>

            <ListView
                android:id="@+id/list_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:padding="0dp"
                android:transcriptMode="normal"
                android:stackFromBottom="false"/>
            <TextView
                android:id="@+id/txtTodayNoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No Birthday's Today!! "
                android:visibility="gone"
                android:textColor="@color/gray_20"
                android:textStyle="bold"
                android:textSize="14sp"
                android:padding="8dp" />

            <!-- Upcoming -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp">

                <TextView
                    android:id="@+id/header_upcoming"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:text="Upcoming"
                    android:textColor="@color/bg_blue"
                    android:background="@drawable/bg_light_blue"
                    android:backgroundTint="@color/bg_lite_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingVertical="4dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#BDBDBD" />

            </LinearLayout>
            <!--            <TextView-->
            <!--                android:id="@+id/header_upcoming"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:text=" Upcoming "-->
            <!--                android:textStyle="bold"-->
            <!--                android:textSize="16sp"-->
            <!--                android:padding="5dp"-->
            <!--                android:layout_marginTop="8dp"-->
            <!--                android:textColor="@color/Green_45" />-->

            <ListView
                android:id="@+id/list_upcoming"
                android:layout_width="match_parent"

                android:layout_height="wrap_content"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none"
                android:transcriptMode="normal"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:padding="0dp"
                android:stackFromBottom="false" />
            <TextView
                android:id="@+id/txtUpcomingNoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No Birthday's Upcoming!! "
                android:visibility="gone"
                android:textColor="@color/gray_20"
                android:textStyle="bold"
                android:textSize="14sp"
                android:padding="8dp" />

            <!-- Belated -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp">

                <TextView
                    android:id="@+id/header_belated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:text="Belated"
                    android:textColor="@color/pink"
                    android:background="@color/bg_grey_70"
                    android:backgroundTint="@color/text_sync_bg"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingVertical="4dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#BDBDBD" />
            </LinearLayout>

            <ListView
                android:id="@+id/list_belated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:padding="0dp"
                android:transcriptMode="normal"
                android:stackFromBottom="false"/>
            <TextView
                android:id="@+id/txtBelatedNoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No Birthday's Belated!! "
                android:visibility="gone"
                android:textColor="@color/gray_20"
                android:textStyle="bold"
                android:textSize="14sp"
                android:padding="8dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
