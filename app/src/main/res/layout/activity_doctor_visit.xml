<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activity.reports.missedReport.DoctorVisitActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/doctorVisitScreen"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/text_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="7.80dp">

            <ImageView
                android:id="@+id/image_back"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/back_arrow_white" />

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doctor Visit"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:id="@+id/missedtittle"
        android:layout_width="@dimen/_120sdp"
        android:layout_height="@dimen/_25sdp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/edittext_stroke"
        android:fontFamily="@font/satoshi_medium"
        android:gravity="start|center_vertical"
        android:paddingStart="@dimen/_10sdp"
        android:textColor="@color/black"
        android:text="Missed: 0"
        android:textStyle="bold"
        android:textSize="@dimen/_7sdp"
        app:layout_constraintEnd_toStartOf="@id/cl_search_sort"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/doctorVisitScreen"
        tools:ignore="SpUsage" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_search_sort"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/missedtittle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/missedtittle"
        app:layout_constraintTop_toBottomOf="@id/doctorVisitScreen">

        <EditText
            android:id="@+id/searchET"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/edittext_stroke"
            android:cursorVisible="false"
            android:hint="Search"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:paddingStart="36dp"
            android:paddingEnd="24dp"
            android:singleLine="true"
            android:textColor="@color/text_dark_65"
            android:textColorHint="@color/text_dark_65"
            android:textSize="@dimen/_6sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/missedfilter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SpUsage" />

        <View
            android:id="@+id/searchBkn"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginStart="8dp"
            android:background="@drawable/edittext_stroke"
            android:backgroundTint="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/searchET"
            app:layout_constraintStart_toStartOf="@id/searchET"
            app:layout_constraintTop_toTopOf="@id/searchET" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="10dp"
            android:src="@drawable/search_icon_gray"
            app:layout_constraintBottom_toBottomOf="@id/searchBkn"
            app:layout_constraintEnd_toEndOf="@id/searchBkn"
            app:layout_constraintStart_toStartOf="@id/searchBkn"
            app:layout_constraintTop_toTopOf="@id/searchBkn" />

        <ImageView
            android:id="@+id/searchClearIcon"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_gravity="center"
            android:layout_marginEnd="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/img_close"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/searchET"
            app:layout_constraintEnd_toEndOf="@id/searchET"
            app:layout_constraintTop_toTopOf="@id/searchET" />

        <View
            android:id="@+id/missedfilter"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/black_stroke"
            android:backgroundTint="@color/text_dark"
            app:layout_constraintBottom_toBottomOf="@id/searchET"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/searchET"
            app:layout_constraintTop_toTopOf="@id/searchET" />


        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/iv_filter"
            android:background="@drawable/bg_purple"
            app:layout_constraintBottom_toBottomOf="@id/missedfilter"
            app:layout_constraintEnd_toEndOf="@id/missedfilter"
            app:layout_constraintStart_toStartOf="@id/missedfilter"
            app:layout_constraintTop_toTopOf="@id/missedfilter" />
        <TextView
            android:id="@+id/tv_filter_count"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_1sdp"
            android:layout_marginEnd="@dimen/_3sdp"
            android:background="@drawable/bg_green_round"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="@dimen/_4ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            tools:ignore="HardcodedText,TextSizeCheck,TextContrastCheck" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDoctorVisit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:visibility="visible"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/missedtittle"
        app:layout_constraintVertical_bias="0"
        tools:listitem="@layout/item_doctor_visit"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/no_doctor"
        android:text="No Doctor Available"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"/>


</androidx.constraintlayout.widget.ConstraintLayout>