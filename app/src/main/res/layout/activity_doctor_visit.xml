<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".activity.reports.missedReport.DoctorVisitActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/doctorVisitScreen"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/text_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="7.80dp">

            <ImageView
                android:id="@+id/image_back"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/back_arrow_white" />

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/doctor_visit"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"  />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/switch_txt"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginStart="@dimen/_3sdp"
        android:background="@drawable/bg_white_border_purple"
        android:backgroundTint="@color/light_grey_1"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/doctorVisitScreen"
        app:layout_constraintEnd_toStartOf="@+id/cl_search_sort"
        app:layout_constraintStart_toStartOf="parent">


    <TextView
        android:id="@+id/missedtittle"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_2sdp"
        android:background="@drawable/bg_dark_purple"
        android:gravity="center"
        android:singleLine="true"
        android:text="@string/missed"
        android:textSize="@dimen/_5ssp"
        android:textAppearance="@font/satoshi_bold"
        android:textColor="@color/white">

    </TextView>

    <TextView
        android:id="@+id/visitedtittle"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_2sdp"
        android:gravity="center"
        android:singleLine="true"
        android:text="@string/visited"
        android:textAppearance="@font/satoshi_bold"
        android:textSize="@dimen/_5ssp"
        android:textColor="@color/dark_purple">

    </TextView>
    </LinearLayout>


    <!--    <TextView-->
<!--        android:id="@+id/missedtittle"-->
<!--        android:layout_width="@dimen/_120sdp"-->
<!--        android:layout_height="@dimen/_25sdp"-->
<!--        android:layout_marginStart="20dp"-->
