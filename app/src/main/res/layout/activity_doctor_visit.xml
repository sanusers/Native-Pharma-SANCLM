    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_search_sort"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/switch_txt"
        app:layout_constraintTop_toBottomOf="@id/doctorVisitScreen">

        <EditText
            android:id="@+id/searchET"
            android:layout_width="0dp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginStart="20dp"
            android:background="@drawable/edittext_stroke"
            android:cursorVisible="false"
            android:hint="@string/search"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:paddingStart="36dp"
            android:paddingEnd="24dp"
            android:singleLine="true"
            android:textColor="@color/text_dark_65"
            android:textColorHint="@color/text_dark_65"
            android:textSize="@dimen/_6sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/missedfilter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SpUsage" />

        <View
            android:id="@+id/searchBkn"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginStart="8dp"
            android:background="@drawable/edittext_stroke"
            android:backgroundTint="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/searchET"
            app:layout_constraintStart_toStartOf="@id/searchET"
            app:layout_constraintTop_toTopOf="@id/searchET" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="10dp"
            android:src="@drawable/search_icon_gray"
            app:layout_constraintBottom_toBottomOf="@id/searchBkn"
            app:layout_constraintEnd_toEndOf="@id/searchBkn"
            app:layout_constraintStart_toStartOf="@id/searchBkn"
            app:layout_constraintTop_toTopOf="@id/searchBkn" />

        <ImageView
            android:id="@+id/searchClearIcon"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_gravity="center"
            android:layout_marginEnd="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/img_close"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/searchET"
            app:layout_constraintEnd_toEndOf="@id/searchET"
            app:layout_constraintTop_toTopOf="@id/searchET" />

        <View
            android:id="@+id/missedfilter"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/black_stroke"
            android:backgroundTint="@color/text_dark"
            app:layout_constraintBottom_toBottomOf="@id/searchET"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/searchET"
            app:layout_constraintTop_toTopOf="@id/searchET" />


        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/iv_filter"
            android:background="@drawable/bg_purple"
            app:layout_constraintBottom_toBottomOf="@id/missedfilter"
            app:layout_constraintEnd_toEndOf="@id/missedfilter"
            app:layout_constraintStart_toStartOf="@id/missedfilter"
            app:layout_constraintTop_toTopOf="@id/missedfilter" />
       <!-- <TextView
            android:id="@+id/tv_filter_count"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_1sdp"
            android:layout_marginEnd="@dimen/_3sdp"
            android:background="@drawable/bg_green_round"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="@dimen/_4ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            tools:ignore="HardcodedText,TextSizeCheck,TextContrastCheck" />-->
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDoctorVisit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="20dp"
        android:visibility="visible"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switch_txt"
        app:layout_constraintVertical_bias="0"
        tools:listitem="@layout/item_doctor_visit"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/no_doctor"
        android:text="@string/no_doctor_available"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"/>


</androidx.constraintlayout.widget.ConstraintLayout>