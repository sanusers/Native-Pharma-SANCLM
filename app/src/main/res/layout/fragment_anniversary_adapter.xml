<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/_5sdp"
    android:weightSum="2"
    tools:ignore="MissingConstraints">

    <!-- ✅ LEFT CARD -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="@dimen/_4sdp">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_2sdp">

                <LinearLayout
                    android:id="@+id/doctorNameLayoutWeds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/_2sdp"
                    android:weightSum="10">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="6"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/dr_imgWeds"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/tp_dr_icon" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/numberWeds"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:text="1)"
                                    android:fontFamily="@font/satoshi_bold"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_5ssp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/textDoctorWeds"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Dr. Ganapathy Ram"
                                    android:fontFamily="@font/satoshi_bold"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_5ssp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textPlaceWeds"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:text="Nandanam"
                                android:layout_marginStart="@dimen/_6sdp"
                                android:fontFamily="@font/satoshi_medium"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_5ssp" />

                        </LinearLayout>



                    </LinearLayout>
                    <TextView
                        android:id="@+id/textDow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="12-Oct-1987"
                        android:fontFamily="@font/satoshi_medium"
                        android:textColor="@color/black"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="8dp"
                        android:textSize="@dimen/_5ssp"
                        android:textStyle="bold"
                        android:layout_weight="3"
                        android:gravity="end" />

                    <LinearLayout
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:layout_weight="1"
                        android:gravity="end">

                    <ImageView
                            android:id="@+id/imgAnniversaryWeds"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:src="@drawable/birthday"
                            android:layout_gravity="end"

                            android:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/dividerViewWeds"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/_2sdp"
                    android:background="#CCCCCC" />

                <LinearLayout
                    android:id="@+id/doctorNameWeds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/_2sdp"
                    android:weightSum="4">

                    <LinearLayout
                        android:id="@+id/layoutQualificationWeds"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_5sdp">

                        <TextView
                            android:id="@+id/drqualWeds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Qualification"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="@dimen/_6ssp" />

                        <TextView
                            android:id="@+id/QualificationWeds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="MBBS(Ortho)"
                            android:fontFamily="@font/satoshi_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutCategoryWeds"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_5sdp">

                        <TextView
                            android:id="@+id/drcatWeds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="@dimen/_5ssp" />

                        <TextView
                            android:id="@+id/CategoryWeds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="C"
                            android:fontFamily="@font/satoshi_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutSpecialityWeds"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_5sdp">

                        <TextView
                            android:id="@+id/drspecWeds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Speciality"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="@dimen/_5ssp" />

                        <TextView
                            android:id="@+id/SpecialityWeds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="Cardio"
                            android:fontFamily="@font/satoshi_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutClassWeds"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/drclassWeds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Class"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="@dimen/_5ssp" />

                        <TextView
                            android:id="@+id/ClassWeds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="A"
                            android:fontFamily="@font/satoshi_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- ✅ RIGHT CARD -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/_4sdp">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_Right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_2sdp">

            <LinearLayout
                android:id="@+id/doctorNameLayoutWeds2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/_2sdp"
                android:weightSum="10">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="6"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/dr_imgWeds2"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/tp_dr_icon" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/numberWeds2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:text="1)"
                                android:fontFamily="@font/satoshi_bold"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_5ssp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textDoctorWeds2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Dr. Ganapathy Ram"
                                android:fontFamily="@font/satoshi_bold"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_5ssp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textPlaceWeds2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:text="Nandanam"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:fontFamily="@font/satoshi_medium"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp" />
                    </LinearLayout>


                </LinearLayout>
                <TextView
                    android:id="@+id/textDow2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="12-Oct-1987"
                    android:fontFamily="@font/satoshi_medium"
                    android:textColor="@color/black"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="8dp"
                    android:textSize="@dimen/_5ssp"
                    android:textStyle="bold"
                    android:layout_weight="3"
                    android:gravity="end" />

                <LinearLayout
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_weight="1"
                    android:gravity="end">

                    <ImageView
                        android:id="@+id/imgAnniversaryWeds2"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:src="@drawable/birthday"
                       android:layout_gravity="end"
                        android:visibility="visible" />

                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/dividerViewWeds2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/_2sdp"
                android:background="#CCCCCC" />

            <LinearLayout
                android:id="@+id/doctorNameWeds2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/_2sdp"
                android:weightSum="4">

                <LinearLayout
                    android:id="@+id/layoutQualificationWeds2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/_5sdp">

                    <TextView
                        android:id="@+id/drqualWeds2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Qualification"
                        android:fontFamily="@font/satoshi_medium"
                        android:textSize="@dimen/_6ssp" />

                    <TextView
                        android:id="@+id/QualificationWeds2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:text="MBBS(Ortho)"
                        android:fontFamily="@font/satoshi_bold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_5ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutCategoryWeds2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/_5sdp">

                    <TextView
                        android:id="@+id/drcatWeds2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Category"
                        android:fontFamily="@font/satoshi_medium"
                        android:textSize="@dimen/_5ssp" />

                    <TextView
                        android:id="@+id/CategoryWeds2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:text="C"
                        android:fontFamily="@font/satoshi_bold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_5ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutSpecialityWeds2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/_5sdp">

                    <TextView
                        android:id="@+id/drspecWeds2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Speciality"
                        android:fontFamily="@font/satoshi_medium"
                        android:textSize="@dimen/_5ssp" />

                    <TextView
                        android:id="@+id/SpecialityWeds2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:text="Cardio"
                        android:fontFamily="@font/satoshi_bold"
