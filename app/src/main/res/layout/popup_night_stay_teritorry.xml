<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/_2sdp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:fontFamily="@font/satoshi_bold"
            android:gravity="center"
            android:padding="@dimen/_4sdp"
            android:text="@string/night_stay"
            android:textColor="@color/dark_purple"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/view_dummy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/view_dummy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/light_grey_3"
           android:layout_below="@+id/tv_head"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="0.0" />
<!--        android:layout_marginVertical="@dimen/_2sdp"-->

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ed_alert_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_head"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:padding="@dimen/_2sdp"
            android:layout_alignParentStart="true"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="left"
            android:text="@string/you_are_staying_overnight"
            android:paddingVertical="@dimen/_3sdp"
            android:textSize="@dimen/_7sdp"
            android:textStyle="bold" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/select_hq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ed_alert_msg"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:padding="@dimen/_2sdp"
            android:textColor="@color/dark_purple"
            android:layout_alignParentStart="true"
            android:fontFamily="@font/satoshi_bold"
            android:gravity="left"
            android:text="@string/select_head_quarter"
            android:paddingVertical="@dimen/_3sdp"
            android:textSize="@dimen/_6sdp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerHeadQuaters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:paddingStart="8dp"
            android:background="@drawable/spinner"
            android:layout_below="@+id/select_hq"
            android:paddingEnd="8dp" />
<!--        android:layout_marginTop="@dimen/_4sdp"-->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/select_territory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/spinnerHeadQuaters"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:padding="@dimen/_2sdp"
            android:layout_alignParentStart="true"
            android:fontFamily="@font/satoshi_bold"
            android:gravity="left"
            android:textColor="@color/dark_purple"
            android:text="Select Territory"
            android:paddingVertical="@dimen/_3sdp"
            android:textSize="@dimen/_6ssp"
           android:textStyle="bold" />
        <Spinner
            android:id="@+id/spinnerTerritory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:background="@drawable/spinner"
            android:layout_below="@id/select_territory"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />
<!--        android:layout_marginTop="@dimen/_50sdp"-->
        <!-- Remarks -->
<!--        <androidx.constraintlayout.widget.ConstraintLayout-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="@dimen/_3sdp"/>-->

        <TextView
            android:id="@+id/tv_head2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="@font/satoshi_bold"
            android:gravity="center"
            android:padding="@dimen/_2sdp"
            android:text="@string/night_stay_remarks"
            android:textColor="@color/dark_purple"
            android:textSize="@dimen/_6ssp"
            android:textStyle="bold"
           android:layout_below="@+id/spinnerTerritory"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--        <ImageView-->
        <!--            android:id="@+id/img_close"-->
        <!--            android:layout_width="@dimen/_15sdp"-->
        <!--            android:layout_height="@dimen/_15sdp"-->
        <!--            android:layout_marginEnd="@dimen/_3sdp"-->
        <!--            android:padding="@dimen/_2sdp"-->
        <!--            android:src="@drawable/img_close"-->
        <!--            app:layout_constraintBottom_toBottomOf="@id/tv_head"-->
        <!--            app:layout_constraintEnd_toEndOf="parent"-->
        <!--            app:layout_constraintHorizontal_bias="1.0"-->
        <!--            app:layout_constraintStart_toEndOf="@id/tv_head"-->
        <!--            app:layout_constraintTop_toTopOf="@id/tv_head"-->
        <!--            tools:ignore="ContentDescription" />-->

<!--        <View-->
<!--            android:id="@+id/view_dummy2"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="@dimen/_1sdp"-->
<!--            android:layout_marginVertical="@dimen/_2sdp"-->
<!--            android:background="@color/light_grey_3"-->
<!--            app:layout_constraintBottom_toTopOf="@id/ed_remark"-->
<!--            app:layout_constraintStart_toStartOf="parent"-->
<!--            app:layout_constraintTop_toBottomOf="@id/tv_head2"-->
<!--            app:layout_constraintVertical_bias="0.0" />-->

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/ed_remark"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:background="@drawable/bg_light_cement"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="left"
            android:hint="@string/type_remarks"
            android:padding="@dimen/_4sdp"
            android:inputType="textMultiLine"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:textSize="@dimen/_6ssp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_below="@+id/tv_head2"
            app:layout_constraintBottom_toTopOf="@id/rl_btns"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
<!--        app:layout_constraintTop_toBottomOf="@id/view_dummy2"-->



        <TextView
            android:id="@+id/tv_head3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="@font/satoshi_bold"
            android:gravity="center"
            android:padding="@dimen/_2sdp"
            android:text="@string/day_remarks"
            android:textColor="@color/dark_purple"
            android:textSize="@dimen/_6ssp"
            android:textStyle="bold"
            android:layout_below="@+id/ed_remark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/ed_remark3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:background="@drawable/bg_light_cement"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="left"
            android:hint="@string/type_remarks"
            android:padding="@dimen/_4sdp"
            android:inputType="textMultiLine"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:textSize="@dimen/_6ssp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_below="@+id/tv_head3"
            app:layout_constraintBottom_toTopOf="@id/rl_btns"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
<!--        android:maxLines="1"-->
        <!--        app:layout_constraintTop_toBottomOf="@id/view_dummy2"-->
