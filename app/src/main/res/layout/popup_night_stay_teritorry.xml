        <!--            android:id="@+id/ed_remark"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="@dimen/_42sdp"-->
        <!--            android:layout_marginHorizontal="@dimen/_8sdp"-->
        <!--            android:background="@drawable/bg_light_cement"-->
        <!--            android:fontFamily="@font/satoshi_medium"-->
        <!--            android:gravity="start|top"-->
        <!--            android:hint="@string/type_remarks"-->
        <!--            android:padding="@dimen/_4sdp"-->
        <!--            android:imeOptions="actionDone"-->
        <!--            android:paddingVertical="@dimen/_3sdp"-->
        <!--            android:textSize="@dimen/_6ssp"-->
        <!--            app:layout_constraintBottom_toTopOf="@id/rl_btns"-->
        <!--            app:layout_constraintEnd_toEndOf="parent"-->
        <!--            app:layout_constraintStart_toStartOf="parent"-->
        <!--            app:layout_constraintTop_toBottomOf="@id/view_dummy2" />-->

<!--        <TextView-->
<!--            android:id="@+id/content3"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="@dimen/_42sdp"-->
<!--            android:layout_marginHorizontal="@dimen/_8sdp"-->
<!--            android:fontFamily="@font/satoshi_medium"-->
<!--            android:text="@string/workplan_submit_ack"-->
<!--            android:textAlignment="center"-->
<!--            android:gravity="center"-->
<!--            android:padding="@dimen/_4sdp"-->
<!--            android:paddingVertical="@dimen/_3sdp"-->
<!--            android:visibility="gone"-->
<!--            android:textSize="@dimen/_6ssp"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            app:layout_constraintStart_toStartOf="parent" />-->

        <RelativeLayout
            android:id="@+id/rl_btns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ed_remark3"
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginBottom="@dimen/_5sdp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/btn_submit"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="@drawable/bg_border_with_pink"
                android:fontFamily="@font/satoshi_bold"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/dark_purple"
                android:textSize="@dimen/_6ssp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_submit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_purple"
                android:fontFamily="@font/satoshi_bold"
                android:text="@string/submit"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_6ssp"
                android:textStyle="bold" />
        </RelativeLayout>
    </RelativeLayout>

</androidx.cardview.widget.CardView>
