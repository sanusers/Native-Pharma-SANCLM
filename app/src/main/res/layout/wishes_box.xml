<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- 🎉 Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today's Wishes !!!"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="#222222"
        android:textSize="20sp"
        android:paddingBottom="10dp" />

    <!-- Divider -->
    <View
        android:id="@+id/title_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/bg_grey"
        android:layout_marginBottom="15dp" />

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_marginBottom="10dp">

        <!-- BOTH COLUMNS -->
        <LinearLayout
            android:id="@+id/contentRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <!-- 🎂 BIRTHDAY COLUMN -->
            <LinearLayout
                android:id="@+id/layoutBirthday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_gravity="top|center_horizontal"
                android:gravity="top|center_horizontal"
                android:paddingTop="4dp">

                <!-- Title Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgBirthday"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/birthday"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvBirthdayTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Birthday"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textSize="@dimen/_7sdp" />
                </LinearLayout>

                <!-- Birthday Names -->
                <TextView
                    android:id="@+id/imgwishes_birthday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_4sdp"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/_7sdp"
                    tools:text="1. Dr. Ashok Swaminathan\n   Guntur\n\n2. Dr. Selvaragavan Venugopal pillai\n   Guntur"
                    android:textStyle="bold"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:id="@+id/dividerView"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="12dp"
                android:background="#CCCCCC" />

            <!-- 💐 ANNIVERSARY COLUMN -->
            <LinearLayout
                android:id="@+id/layoutAnniversary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_gravity="top|center_horizontal"
                android:gravity="top|center_horizontal"
                android:paddingTop="4dp">

                <!-- Title Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgAnniversary"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:padding="@dimen/_5sdp"
                        android:src="@drawable/anniversary"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvAnniversaryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Anniversary"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textSize="@dimen/_7sdp" />
                </LinearLayout>

                <!-- Anniversary Names -->
                <TextView
                    android:id="@+id/imgwishes_anniversary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_4sdp"
                    android:fontFamily="@font/satoshi_medium"
                    tools:text="1. Dr. Ashok Swaminathan\n   Guntur\n\n"
                    android:textSize="@dimen/_7sdp"
                    android:textStyle="bold"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Divider -->
    <View
        android:id="@+id/ok_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginTop="10dp" />

    <!-- OK BUTTON -->
    <Button
        android:id="@+id/btnOk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OK"
        android:backgroundTint="@color/dark_purple"
        android:textColor="#FFFFFF"
        android:layout_marginTop="15dp"
        android:fontFamily="@font/satoshi_bold"
        android:textStyle="bold"
        android:textSize="@dimen/_6ssp" />
</LinearLayout>

