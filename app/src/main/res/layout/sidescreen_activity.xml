<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_180sdp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@drawable/border_white"
    android:orientation="vertical"
    tools:showIn="navigation_view1">

    <RelativeLayout
        android:id="@+id/rl_calender_syn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_searchheader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_4sdp"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="center"
            android:padding="@dimen/_4sdp"
            android:text="@string/select"
            android:textColor="@color/black_45"
            android:textSize="@dimen/_7sdp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/cancel_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="-2dp"
            android:layout_marginEnd="13dp"
            android:background="@color/white"
            android:padding="@dimen/_2sdp"
            android:src="@drawable/close_icon" />

    </RelativeLayout>

    <View
        android:id="@+id/view_dummy"
        android:layout_width="wrap_content"
        android:layout_height="0.5dp"
        android:layout_below="@+id/rl_calender_syn"
        android:background="@color/tab_gray" />

    <LinearLayout
        android:id="@+id/ll_search_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/view_dummy"
        android:layout_marginLeft="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginRight="@dimen/_5sdp"
        android:background="@drawable/bg_white_search"
        android:orientation="horizontal"
        android:visibility="visible">

        <ImageView
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_7sdp"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/_3sdp"
            android:src="@drawable/grey_search" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lineid"
            android:layout_margin="@dimen/_1sdp"
            android:background="@null"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="left"
            android:hint="@string/search "
            android:inputType="text"
            android:padding="@dimen/_7sdp"
            android:textSize="@dimen/_6sdp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ac_recyeler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ll_search_layout"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_30sdp"
        android:divider="@null"
        android:visibility="visible" />

    <View
        android:id="@+id/view_dummy1"
        android:layout_width="wrap_content"
        android:layout_height="0.5dp"
        android:layout_above="@+id/txt_cl_done"
        android:background="@color/tab_gray" />

    <TextView
        android:id="@+id/txt_cl_done"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/_3sdp"
        android:background="@drawable/edittext_stroke"
        android:gravity="center"
        android:padding="@dimen/_5sdp"
        android:text="@string/save"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/_7sdp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@color/text_dark"/>

    <TextView
        android:id="@+id/txt_no_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="@dimen/_3sdp"
        android:gravity="center"
        android:padding="@dimen/_5sdp"
        android:text="@string/no_data_available"
        android:textAllCaps="false"
        android:textColor="@color/dark_purple"
        android:textSize="@dimen/_6ssp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@color/text_dark"/>

</RelativeLayout>