<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/popup_background"
    android:elevation="16dp"
    android:gravity="center_horizontal"
    android:layout_margin="@dimen/_2sdp"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/ai_greeting_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/close_popup_button"
        android:layout_marginBottom="16dp"
        android:layout_toStartOf="@id/close_popup_button"
        android:text="Greetings! I am your AI companion, ready to assist you on your journey."
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ai_greeting_text_view">

        <TextView
            android:id="@+id/ai_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ai_greeting_text_view"
            android:layout_marginBottom="16dp"
            android:text="Greetings! I am your AI companion, ready to assist you on your journey."
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />
    </ScrollView>

    <ImageView
        android:id="@+id/close_popup_button"
        android:layout_width="@dimen/_15sdp"
        android:layout_height="@dimen/_15sdp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="@dimen/_2sdp"
        android:src="@drawable/img_close" />

</RelativeLayout>
