<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/_5sdp"
    android:weightSum="2"
    tools:ignore="MissingConstraints">

    <!-- ✅ LEFT CARD -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="@dimen/_4sdp">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_2sdp">

                <LinearLayout
                    android:id="@+id/doctorNameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/_2sdp"
                    android:weightSum="10">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="6"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/dr_img"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/tp_dr_icon" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/number"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:text="1)"
                                    android:fontFamily="@font/satoshi_bold"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_5ssp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/textDoctor"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Dr. Ganapathy Ram"
                                    android:fontFamily="@font/satoshi_bold"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_5ssp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textPlace"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:text="Nandanam"
                                android:layout_marginStart="@dimen/_6sdp"
                                android:fontFamily="@font/satoshi_medium"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_5ssp" />

                        </LinearLayout>



                    </LinearLayout>
                    <TextView
                        android:id="@+id/textDob"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="12-Oct-1987"
                        android:fontFamily="@font/satoshi_medium"
                        android:textColor="@color/black"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="8dp"
                        android:textSize="@dimen/_5ssp"
                        android:textStyle="bold"
                        android:layout_weight="3"
                        android:gravity="end" />

                    <LinearLayout
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:layout_weight="1"
                        android:gravity="end">

                        <ImageView
                            android:id="@+id/imgBirthday"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:src="@drawable/birthday"
                            android:layout_gravity="end"

                            android:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/dividerView"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/_2sdp"
                    android:background="#CCCCCC" />

                <LinearLayout
                    android:id="@+id/doctorNameWeds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/_2sdp"
                    android:weightSum="4">

                    <LinearLayout
                        android:id="@+id/layoutQualification"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_5sdp">

                        <TextView
                            android:id="@+id/drqual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Qualification"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="@dimen/_6ssp" />

                        <TextView
                            android:id="@+id/Qualification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="MBBS(Ortho)"
                            android:fontFamily="@font/satoshi_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_5sdp">

                        <TextView
                            android:id="@+id/drcat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="@dimen/_5ssp" />

                        <TextView
                            android:id="@+id/Category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="C"
                            android:fontFamily="@font/satoshi_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutSpeciality"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_5sdp">

                        <TextView
                            android:id="@+id/drspec"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Speciality"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="@dimen/_5ssp" />

                        <TextView
                            android:id="@+id/Speciality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="Cardio"
                            android:fontFamily="@font/satoshi_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutClass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/drclass"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Class"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="@dimen/_5ssp" />

                        <TextView
                            android:id="@+id/Class"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="A"
                            android:fontFamily="@font/satoshi_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- ✅ RIGHT CARD -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/_4sdp">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_Right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_2sdp">

                <LinearLayout
                    android:id="@+id/doctorNameLayout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/_2sdp"
                    android:weightSum="10">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="6"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/dr_img2"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/tp_dr_icon" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/number2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:text="1)"
                                    android:fontFamily="@font/satoshi_bold"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_5ssp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/textDoctor2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Dr. Ganapathy Ram"
                                    android:fontFamily="@font/satoshi_bold"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_5ssp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textPlace2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:text="Nandanam"
                                android:layout_marginStart="@dimen/_6sdp"
                                android:fontFamily="@font/satoshi_medium"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_5ssp" />
                        </LinearLayout>


                    </LinearLayout>
                    <TextView
                        android:id="@+id/textDob2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="12-Oct-1987"
                        android:fontFamily="@font/satoshi_medium"
                        android:textColor="@color/black"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="8dp"
                        android:textSize="@dimen/_5ssp"
                        android:textStyle="bold"
                        android:layout_weight="3"
                        android:gravity="end" />

                    <LinearLayout
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:layout_weight="1"
                        android:gravity="end">

                        <ImageView
                            android:id="@+id/imgBirthday2"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:src="@drawable/birthday"
                            android:layout_gravity="end"
                            android:visibility="visible" />

                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/dividerView2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/_2sdp"
                    android:background="#CCCCCC" />

                <LinearLayout
                    android:id="@+id/doctorName2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/_2sdp"
                    android:weightSum="4">

                    <LinearLayout
                        android:id="@+id/layoutQualification2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_5sdp">

                        <TextView
                            android:id="@+id/drqual2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Qualification"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="@dimen/_6ssp" />

                        <TextView
                            android:id="@+id/Qualification2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="MBBS(Ortho)"
                            android:fontFamily="@font/satoshi_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutCategory2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_5sdp">

                        <TextView
                            android:id="@+id/drcat2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="@dimen/_5ssp" />

                        <TextView
                            android:id="@+id/Category2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="C"
                            android:fontFamily="@font/satoshi_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutSpeciality2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_5sdp">

                        <TextView
                            android:id="@+id/drspec2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Speciality"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="@dimen/_5ssp" />

                        <TextView
                            android:id="@+id/Speciality2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="Cardio"
                            android:fontFamily="@font/satoshi_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutClass2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/drclass2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Class"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="@dimen/_5ssp" />

                        <TextView
                            android:id="@+id/Class2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="A"
                            android:fontFamily="@font/satoshi_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_5ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</LinearLayout>


