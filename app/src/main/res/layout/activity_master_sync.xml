<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rlHead"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.masterSync.MasterSyncActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/text_dark"
            android:backgroundTint="@color/text_dark"
            android:minHeight="?attr/actionBarSize"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="0dp">

            <LinearLayout
                android:id="@+id/backArrow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:padding="@dimen/_10sdp">

                <ImageView
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:src="@drawable/arrow_back_white" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:fontFamily="@font/satoshi_variable"
                android:text="@string/master_sync"
                android:textColor="@color/white"
                android:textSize="@dimen/_7sdp"
                tools:ignore="SpUsage" />

            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:src="@drawable/img_downloding"
                android:layout_gravity="end"
                android:scaleType="centerCrop"
                android:id="@+id/img_downloading"
                android:layout_marginEnd="@dimen/_3sdp"
                android:visibility="visible"
                android:layout_height="@dimen/_10sdp">

            </ImageView>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/ll1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/appBar"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:weightSum="2">

        <RelativeLayout
            android:id="@+id/hq"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:background="@drawable/one_side_stroke"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp">

            <TextView
                android:id="@+id/hqName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:fontFamily="@font/satoshi_medium"
                android:paddingTop="@dimen/_7sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:hint="@string/select_hq"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/_6sdp"
                android:textStyle="bold"
                tools:ignore="SpUsage" />

            <ImageView
                android:layout_width="7.80dp"
                android:layout_height="7.80dp"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:src="@drawable/arrow_down" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_weight="0.7"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/satoshi_medium"
                android:text="@string/last_sync"
                android:textColor="@color/text_dark_65"
                android:textSize="@dimen/_6sdp"
                android:textStyle="bold"
                tools:ignore="SpUsage" />

            <TextView
                android:id="@+id/lastSyncTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_toEndOf="@id/txt"
                android:fontFamily="@font/satoshi_medium"
                android:text=" 27 Jun 2023 02:38 PM"
                android:textColor="@color/text_dark_65"
                android:textSize="@dimen/_6sdp"
                android:textStyle="bold"
                tools:ignore="SpUsage" />

        </RelativeLayout>

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ll1"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:background="#ececec">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="@dimen/_6sdp"
            android:weightSum="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:scrollbars="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#ececec"
                    android:paddingEnd="@dimen/_3sdp">

                    <TextView
                        android:id="@+id/listedDr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_gravity="center"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/greater_than_white"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="Listed Doctor"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageDr"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/listedDr"
                        android:layout_alignBottom="@id/listedDr"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_24sdp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chemist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/listedDr"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="Chemist"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />

                    <ImageView
                        android:id="@+id/syncFailedImageChm"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/chemist"
                        android:layout_alignBottom="@id/chemist"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/stockiest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/chemist"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="Stockist"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageStk"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/stockiest"
                        android:layout_alignBottom="@id/stockiest"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/unlistedDoctor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/stockiest"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="Unlisted Doctor"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageUnListdr"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/unlistedDoctor"
                        android:layout_alignBottom="@id/unlistedDoctor"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/hospital"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/unlistedDoctor"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="Hospital"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/arrow_down"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageHspl"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/hospital"
                        android:layout_alignBottom="@id/hospital"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="invisible"/>



                    <TextView
                        android:id="@+id/cip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/hospital"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="CIP"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageCip"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/cip"
                        android:layout_alignBottom="@id/cip"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="invisible"/>



                    <TextView
                        android:id="@+id/cluster"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/cip"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="Cluster"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/arrow_down"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageClust"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/cluster"
                        android:layout_alignBottom="@id/cluster"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>


                    <TextView
                        android:id="@+id/input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/cluster"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="@string/input"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageInput"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/input"
                        android:layout_alignBottom="@id/input"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>




                    <TextView
                        android:id="@+id/product"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/input"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="@string/product"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageProduct"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/product"
                        android:layout_alignBottom="@id/product"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/leave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/product"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="@string/leave"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageLeave"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/leave"
                        android:layout_alignBottom="@id/leave"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>




                    <TextView
                        android:id="@+id/dcr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/leave"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="DCR"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageDcr"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/dcr"
                        android:layout_alignBottom="@id/dcr"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>



                    <TextView
                        android:id="@+id/activity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/dcr"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="@string/activity"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageAct"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/activity"
                        android:layout_alignBottom="@id/activity"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tourPlan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/activity"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="@string/tour_plan"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageTP"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/tourPlan"
                        android:layout_alignBottom="@id/tourPlan"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/workType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tourPlan"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="@string/worktype"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageWP"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/workType"
                        android:layout_alignBottom="@id/workType"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>


                    <TextView
                        android:id="@+id/slide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/workType"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="@string/slide"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageSlide"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/slide"
                        android:layout_alignBottom="@id/slide"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/subordinate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/slide"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="@string/subordinate"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageSub"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/subordinate"
                        android:layout_alignBottom="@id/subordinate"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/Other"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/subordinate"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="@string/other"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageOther"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/Other"
                        android:layout_alignBottom="@id/Other"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/Profile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/Other"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="@string/profile"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageProfile"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/Profile"
                        android:layout_alignBottom="@id/Profile"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/setup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/Profile"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/master_sync_selector_stroke"
                        android:drawableEnd="@drawable/arrow_down"
                        android:fontFamily="@font/satoshi_medium"
                        android:padding="@dimen/_7sdp"
                        android:text="@string/setup"
                        android:textColor="@drawable/master_sync_selector_stroke"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/syncFailedImageSet"
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="@dimen/_7sdp"
                        android:src="@drawable/icon_sync_failed"
                        android:layout_alignTop="@id/setup"
                        android:layout_alignBottom="@id/setup"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_23sdp"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:id="@+id/masterSyncAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/setup"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/selector_box"
                        android:gravity="center"
                        android:padding="@dimen/_7sdp">

                        <ImageView
                            android:layout_width="@dimen/_7sdp"
                            android:layout_height="@dimen/_7sdp"
                            android:src="@drawable/refresh_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:fontFamily="@font/satoshi_medium"
                            android:gravity="center"
                            android:text="@string/sync_all"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/_5sdp"
                            android:textStyle="bold"
                            tools:ignore="SpUsage" />

                    </LinearLayout>

                </RelativeLayout>

            </androidx.core.widget.NestedScrollView>

            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:paddingTop="@dimen/_4sdp"
                android:scrollbars="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="@dimen/_3sdp">

                        <LinearLayout
                            android:id="@+id/checkInOutLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:weightSum="1">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight=".75"
                                app:cardCornerRadius="@dimen/_2sdp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@color/pink_15"
                                    android:orientation="horizontal">

                                    <androidx.cardview.widget.CardView
                                        android:layout_width="@dimen/_2sdp"
                                        android:layout_height="match_parent"
                                        android:backgroundTint="@color/dark_pink"
                                        app:cardCornerRadius="@dimen/_2sdp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:fontFamily="@font/satoshi_medium"
                                        android:padding="@dimen/_4sdp"
                                        android:text="@string/master_note"
                                        android:textColor="@color/dark_pink"
                                        android:textSize="@dimen/_6sdp"
                                        tools:ignore="SpUsage" />

                                </LinearLayout>

                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/checkInOutLayout"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentEnd="true"
                            android:paddingStart="@dimen/_minus4sdp"
                            android:paddingTop="@dimen/_4sdp"
                            android:paddingEnd="@dimen/_minus4sdp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/recView"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <Button
                                android:id="@+id/childSync"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginEnd="@dimen/_3sdp"
                                android:layout_weight="1"
                                android:background="@drawable/selector_box"
                                android:fontFamily="@font/satoshi_variable"
                                android:gravity="center"
                                android:padding="@dimen/_9sdp"
                                android:text="Sync Listed Doctor"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_6sdp"
                                app:backgroundTint="@color/text_dark"
                                tools:ignore="SpUsage" />

                            <Button
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="@dimen/_3sdp"
                                android:layout_marginEnd="@dimen/_3sdp"
                                android:layout_weight="1"
                                android:visibility="invisible" />

                            <Button
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="@dimen/_3sdp"
                                android:layout_weight="1"
                                android:visibility="invisible" />

                        </LinearLayout>

                    </RelativeLayout>

                </RelativeLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>