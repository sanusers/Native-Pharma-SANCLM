<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rlHead"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_screen"
    tools:context=".activity.splash.SplashScreen">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_bkn2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/view1"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/triAngle"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_21sdp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="38dp"
            android:background="@drawable/yellow_triangle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/view1"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/view2"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/microScopeImg"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginBottom="120dp"
            android:background="@drawable/micro_scope"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/view2"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/conicalImg"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/conical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/microScopeImg"
            app:layout_constraintStart_toStartOf="@+id/microScopeImg"
            app:layout_constraintTop_toBottomOf="@+id/microScopeImg" />

        <saneforce.sanzen.commonClasses.GifView
            android:id="@+id/splashImg"
            android:layout_width="@dimen/_280sdp"
            android:layout_height="@dimen/_200sdp"
            android:src="@drawable/animation_slide"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/microScopeImg"
            app:layout_constraintStart_toEndOf="@id/triAngle"
            app:layout_constraintTop_toTopOf="parent">

        </saneforce.sanzen.commonClasses.GifView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

