<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_130sdp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="6dp">

        <!-- Parent ConstraintLayout instead of RelativeLayout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <TextView
                android:id="@+id/headerTxt"
                android:layout_width="0dp"
                android:layout_height="@dimen/_15sdp"
                android:fontFamily="@font/satoshi_bold"
                android:gravity="center"
                android:text="MR Name - HQ - Designation"
                android:textColor="@color/red_60"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>


            <ImageView
                android:id="@+id/unlistedDrImg"
                android:layout_width="52dp"
                android:layout_height="@dimen/_25sdp"
                android:src="@drawable/tp_unlist_dr_icon"
                app:layout_constraintTop_toBottomOf="@id/headerTxt"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_7sdp"/>

            <!-- Visit Text -->
            <TextView
                android:id="@+id/unlistedDrVisitTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_bold"
                android:text="Unlisted Doctor Visit"
                android:textColor="@color/black"
                android:textSize="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_9sdp"
                app:layout_constraintStart_toEndOf="@id/unlistedDrImg"
                app:layout_constraintTop_toTopOf="@id/unlistedDrImg"
                android:layout_marginStart="@dimen/_5sdp"/>

            <!-- Date -->
            <TextView
                android:id="@+id/dateTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_bold"
                android:text="Oct 2025"
                android:textColor="@color/black"
                android:textSize="@dimen/_6sdp"
                app:layout_constraintStart_toStartOf="@id/unlistedDrImg"
                app:layout_constraintTop_toBottomOf="@id/unlistedDrImg"
                android:layout_marginTop="@dimen/_2sdp"/>

            <!-- Stats Grid -->
            <GridLayout
                android:id="@+id/statsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/border_spinner_uneditable"
                android:columnCount="3"
                android:rowCount="2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dateTxt">


                <LinearLayout
                    android:id="@+id/grid1"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_margin="2dp"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:text="Total Unlisted Doctor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/satoshi_bold"
                        android:text="20"
                        android:textColor="@color/black" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/grid2"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_margin="2dp"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:text="Visited" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/satoshi_bold"
                        android:text="20"
                        android:textColor="@color/black" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/grid3"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_row="0"
                    android:layout_column="2"
                    android:layout_margin="2dp"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:text="Missed" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/satoshi_bold"
                        android:text="20"
                        android:textColor="@color/black" />

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/grid4"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_margin="2dp"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:text="Field Work Days" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/satoshi_bold"
                        android:text="20"
                        android:textColor="@color/black" />

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/grid5"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_margin="2dp"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:text="Call Average" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/satoshi_bold"
                        android:text="20"
                        android:textColor="@color/black" />

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/grid6"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_row="1"
                    android:layout_column="2"
                    android:layout_margin="2dp"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:text="Coverage" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/satoshi_bold"
                        android:text="20"
                        android:textColor="@color/black" />

                </LinearLayout>


            </GridLayout>

            <!-- Chart Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/chartCard"
                android:layout_width="700dp"
                android:layout_height="@dimen/_92sdp"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@id/statsGrid"
                app:layout_constraintTop_toBottomOf="@id/headerTxt"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_10sdp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <include
                        android:id="@+id/in_chart_visit"
                        layout="@layout/barchartvisit"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
