<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_head"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_5sdp" >

    <TextView
        android:id="@+id/tv_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:fontFamily="@font/satoshi_bold"
        android:textAlignment="textStart"
        android:textColor="@color/red_60"
        android:textSize="@dimen/_8ssp"
        android:textStyle="bold"
        tools:text="header" />

    <ImageView
        android:id="@+id/iv_head_arrow"
        android:layout_width="@dimen/_15sdp"
        android:layout_height="@dimen/_15sdp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:padding="@dimen/_5sdp"
        android:src="@drawable/down_arrow"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignBottom="@id/tv_head"
        android:layout_marginStart="@dimen/_3sdp"
        android:layout_toStartOf="@id/iv_head_arrow"
        android:layout_toEndOf="@id/tv_head"
        android:background="@color/light_cement" />

</RelativeLayout>