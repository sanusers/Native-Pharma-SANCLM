                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_qua"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="15dp"
                                android:text="@string/qualifications_mandt"
                                android:textColor="#000000" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/txt_select_qua"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_17sdp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/border_shape_spinner"
                                android:clickable="true"
                                android:focusable="false"
                                android:drawableEnd="@drawable/down_arrow"
                                android:inputType="none"
                                android:hint="@string/select"
                                android:textColorHint="@color/black"
                                android:padding="5dp"
                                android:textColor="#000000"
                                android:textSize="@dimen/_7ssp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/three_two"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/DOB"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="15dp"
                                android:text="@string/DOB"
                                android:textColor="#000000" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/shape_white_grey"
                                android:orientation="horizontal">

                                <androidx.appcompat.widget.AppCompatEditText
                                    android:id="@+id/edt_dob"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/_17sdp"
                                    android:layout_weight="1"
                                    android:background="@drawable/border_shape_spinner"
                                    android:clickable="true"
                                    android:padding="5dp"
                                    android:focusable="false"
                                    android:textColor="#000000"
                                    android:textSize="@dimen/_6ssp" />

                                <ImageView
                                    android:id="@+id/dob_calendar_icon"
                                    android:layout_width="40dp"
                                    android:layout_height="@dimen/_17sdp"
